<li class="nav-item dropdown user-menu">
  <a href="#" class="nav-link d-flex align-items-center" data-toggle="dropdown" style="color: var(--heleguo-text-secondary);">
    <picture>
      <source srcset="{{ avatar }}" type="image/webp">
      <img src="{{ avatar_png }}" class="bs-avatar mr-2" alt="User Image">
    </picture>
    <span class="d-none d-md-inline d-sm-block" data-mark="nickname">
      {{ user.nickname ?? user.email }}
    </span>
  </a>

  <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right" style="border: 1px solid var(--heleguo-border-color); border-radius: 12px; box-shadow: 0 8px 32px rgba(0,0,0,0.15);">
    {% for item in menu %}
      {% if item.link == '#divider' %}
        <div class="dropdown-divider"></div>
      {% else %}
        <a class="dropdown-item" href="{{ item.link }}" style="color: var(--heleguo-text-secondary); transition: all 0.2s;">{{ item.label }}</a>
      {% endif %}
    {% endfor %}
    <div class="dropdown-divider"></div>
    <a class="dropdown-item" href="#" id="logout-button" style="color: var(--heleguo-text-secondary);">
      {{ trans('general.logout') }}
    </a>
  </div>
</li>
