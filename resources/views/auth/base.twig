<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    {{ include('shared.head') }}
    <title>{% block title %}{% endblock %} - {{ site_name }}</title>
  </head>

  <body class="{{ dark_mode ? 'dark-mode' : '' }} hold-transition login-page">
    <div class="login-box">
      <div class="login-logo">
        <a href="{{ url('/') }}">
          <img src="https://cdn.heleguo.cn/logo/logo.png" alt="{{ site_name }}" class="auth-logo-img">
          <span>{{ site_name }}</span>
        </a>
      </div>

      <div class="card">
        <div class="card-body login-card-body">
          {% block content %}{% endblock %}
        </div>
      </div>
    </div>

    {% block before_foot %}{% endblock %}
    {{ include('shared.foot') }}
  </body>
</html>
