<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    {{ include('shared.head') }}
    <link rel="preload" as="image" href="{{ home_pic_url }}">
    <title>{{ site_name }}</title>
    <style>
      .hp-hero-bg img {
        {% if fixed_bg %}
          display: none;
        {% endif %}
      }
      {% if fixed_bg %}
        .hp-hero { background-image: url('{{ home_pic_url }}'); background-size: cover; background-position: center; }
      {% endif %}
    </style>
    {{ include('assets.home-css', ignore_missing = true) }}
  </head>

  <body class="{{ dark_mode ? 'dark-mode' : '' }}">
    <!-- Navbar -->
    <nav class="hp-nav" id="hp-nav">
      <div class="hp-nav-inner">
        <a href="{{ url('/') }}" class="hp-nav-brand">
          <img src="https://cdn.heleguo.cn/logo/logo.png" alt="{{ site_name }}" class="hp-nav-logo">
        </a>

        <ul class="hp-nav-links" id="hp-nav-links">
          <li><a href="{{ url('/') }}" class="active">首页</a></li>
          <li><a href="{{ url('skinlib') }}">{{ trans('general.skinlib') }}</a></li>
          {{ include('shared.languages') }}
        </ul>

        <div class="hp-nav-right">
          {% if auth_check() %}
            <a href="{{ url('user') }}" class="hp-btn hp-btn-primary hp-nav-cta" style="padding: 0.5rem 1.5rem; font-size: 0.875rem;">
              {{ trans('general.user-center') }}
            </a>
          {% else %}
            <a href="{{ url('auth/login') }}" class="hp-btn hp-btn-outline hp-nav-cta" style="padding: 0.5rem 1.5rem; font-size: 0.875rem;">
              登录
            </a>
            <a href="{{ url('auth/register') }}" class="hp-btn hp-btn-primary hp-nav-cta" style="padding: 0.5rem 1.5rem; font-size: 0.875rem;">
              注册
            </a>
          {% endif %}
          <button class="hp-nav-toggle" id="hp-nav-toggle" aria-label="Toggle menu">
            &#9776;
          </button>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="hp-hero">
      <div class="hp-hero-bg">
        <img src="{{ home_pic_url }}" alt="{{ site_name }}">
        <div class="hp-hero-overlay"></div>
        <div class="hp-hero-gradient"></div>
      </div>

      <!-- Floating Particles -->
      <div class="hp-hero-particles" id="hp-particles"></div>

      <div class="hp-hero-content">
        <div class="animate-slide-up">
          <span class="hp-hero-badge">Minecraft 服务器</span>
        </div>

        <h1 class="hp-hero-title animate-slide-up stagger-1">
          欢迎来到 <span class="text-gradient">{{ site_name }}</span>
        </h1>

        <p class="hp-hero-subtitle animate-slide-up stagger-2">
          {{ site_description }}
        </p>

        {% if server_ip is defined and server_ip %}
        <div class="hp-hero-ip animate-slide-up stagger-3">
          <div class="hp-hero-ip-box">
            <span class="hp-hero-ip-icon">&#9881;</span>
            <span class="hp-hero-ip-text">{{ server_ip }}</span>
            <button class="hp-hero-ip-copy" onclick="navigator.clipboard.writeText('{{ server_ip }}'); this.innerHTML='&#10003;'; setTimeout(()=>this.innerHTML='&#128203;',2000)" title="复制IP">
              &#128203;
            </button>
          </div>
        </div>
        {% endif %}

        <div class="hp-hero-actions animate-slide-up stagger-4">
          {% if auth_check() %}
            <a href="{{ url('user') }}" class="hp-btn hp-btn-primary">
              &#127918; {{ trans('general.user-center') }}
            </a>
          {% else %}
            <a href="{{ url('auth/register') }}" class="hp-btn hp-btn-primary">
              &#127918; 立即加入
            </a>
          {% endif %}
          <a href="{{ url('skinlib') }}" class="hp-btn hp-btn-outline">
            &#127912; {{ trans('general.skinlib') }}
          </a>
        </div>
      </div>

      <!-- Scroll Indicator -->
      <div class="hp-hero-scroll">
        <div class="hp-hero-scroll-mouse">
          <div class="hp-hero-scroll-dot"></div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    {% if not hide_intro %}
    <section class="hp-section">
      <div class="hp-container">
        <div class="hp-section-header">
          <h2 class="hp-section-title">
            服务器 <span class="text-gradient">特色</span>
          </h2>
          <p class="hp-section-desc">我们致力于提供最佳的游戏体验</p>
        </div>

        <div class="hp-features-grid">
          {% for item in ['first', 'second', 'third'] %}
          <div class="hp-card card-lift animate-slide-up stagger-{{ loop.index }}">
            <div class="hp-card-body">
              <div class="hp-card-icon">
                <i class="fas {{ trans("index.features.#{item}.icon") }}"></i>
              </div>
              <h3 class="hp-card-title">{{ trans("index.features.#{item}.name") }}</h3>
              <p class="hp-card-text">{{ trans("index.features.#{item}.desc")|raw }}</p>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="hp-section">
      <div class="hp-container">
        <div class="hp-cta-card">
          <div class="hp-cta-grid">
            <div>
              <h2 class="hp-section-title" style="text-align:left; margin-bottom:1rem;">
                {{ trans('index.introduction', {sitename: site_name})|striptags|slice(0, 60) }}
              </h2>
              <p style="color: var(--text-secondary); margin-bottom: 2rem;">
                {{ trans('index.introduction', {sitename: site_name})|striptags|slice(0, 120) }}
              </p>
              <a href="{{ url('auth/register') }}" class="hp-btn hp-btn-primary">
                {{ trans('index.start') }}
              </a>
            </div>
            <div class="hp-cta-icon-wrap">
              <div class="hp-cta-icon-glow"></div>
              <div class="hp-cta-icon">&#127918;</div>
            </div>
          </div>
        </div>
      </div>
    </section>
    {% endif %}

    <!-- Footer -->
    <footer class="hp-footer">
      <div class="hp-container">
        <div class="hp-footer-grid">
          <div class="hp-footer-brand">
            <a href="{{ url('/') }}" class="hp-nav-brand" style="margin-bottom:1rem;">
              <img src="https://cdn.heleguo.cn/logo/logo.png" alt="{{ site_name }}" class="hp-footer-logo">
            </a>
            <p>{{ site_description }}</p>
          </div>

          <div class="hp-footer-col">
            <h3>导航</h3>
            <ul>
              <li><a href="{{ url('/') }}">首页</a></li>
              <li><a href="{{ url('skinlib') }}">{{ trans('general.skinlib') }}</a></li>
              {% if auth_check() %}
                <li><a href="{{ url('user') }}">{{ trans('general.user-center') }}</a></li>
              {% else %}
                <li><a href="{{ url('auth/login') }}">{{ trans('general.login') }}</a></li>
              {% endif %}
            </ul>
          </div>

          {% if server_ip is defined and server_ip %}
          <div class="hp-footer-col">
            <h3>服务器</h3>
            <ul>
              <li>
                <button onclick="window.open('minecraft://{{ server_ip }}', '_blank')">
                  {{ site_name }}
                  <span style="display:block; font-size:0.75rem; opacity:0.7;">{{ server_ip }}</span>
                </button>
              </li>
            </ul>
          </div>
          {% endif %}

          <div class="hp-footer-col">
            <h3>链接</h3>
            <ul>
              <li><a href="{{ url('skinlib') }}">{{ trans('general.skinlib') }}</a></li>
              <li><a href="https://github.com/bs-community/blessing-skin-server" target="_blank">GitHub</a></li>
            </ul>
          </div>
        </div>

        <div class="hp-footer-bottom">
          <div class="hp-footer-copyright">
            &copy; {{ "now"|date("Y") }} {{ site_name }}. All rights reserved.
          </div>
          <div class="hp-footer-copyright">
            {{ include('shared.copyright') }}
          </div>
        </div>
      </div>
    </footer>

    <script>
    // Navbar scroll effect
    (function() {
      var nav = document.getElementById('hp-nav');
      window.addEventListener('scroll', function() {
        if (window.scrollY > 50) {
          nav.classList.add('scrolled');
        } else {
          nav.classList.remove('scrolled');
        }
      });
    })();

    // Mobile nav toggle
    (function() {
      var toggle = document.getElementById('hp-nav-toggle');
      var links = document.getElementById('hp-nav-links');
      if (toggle && links) {
        toggle.addEventListener('click', function() {
          links.classList.toggle('mobile-open');
        });
      }
    })();

    // Floating particles
    (function() {
      var container = document.getElementById('hp-particles');
      if (!container) return;
      for (var i = 0; i < 20; i++) {
        var p = document.createElement('div');
        p.className = 'hp-hero-particle';
        p.style.left = (Math.random() * 100) + '%';
        p.style.top = (Math.random() * 100) + '%';
        p.style.animationDelay = (Math.random() * 4) + 's';
        p.style.animationDuration = (4 + Math.random() * 4) + 's';
        container.appendChild(p);
      }
    })();
    </script>

    <script type="application/json" id="blessing-extra">
      {{ {transparent_navbar: transparent_navbar}|json_encode|raw }}
    </script>
    {{ include('assets.home', ignore_missing = true) }}
    {{ include('shared.foot') }}
  </body>
</html>
